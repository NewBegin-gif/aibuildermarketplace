{
 "openapi": "3.1.0",
 "info": {
  "title": "AIBuilder Marketplace software records",
  "version": "1.0",
  "description": "Read-only records of hand-researched B2B and AI software: prices per plan where structured, cost traps with their full evidence sentence, the date the pricing was read, what is unknown, and the vendor handoff with affiliate disclosure. Static JSON; no authentication.",
  "license": {
   "name": "CC BY 4.0",
   "url": "https://creativecommons.org/licenses/by/4.0/"
  },
  "contact": {
   "url": "https://aibuildermarketplace.com/agents/"
  }
 },
 "servers": [
  {
   "url": "https://aibuildermarketplace.com/api/v1"
  }
 ],
 "paths": {
  "/index.json": {
   "get": {
    "operationId": "listProducts",
    "summary": "Catalog: one compact row per product, plus policy and counts",
    "responses": {
     "200": {
      "description": "Catalog",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Catalog"
        }
       }
      }
     }
    }
   }
  },
  "/products/{id}.json": {
   "get": {
    "operationId": "getProduct",
    "summary": "Full record for one product",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[a-z0-9-]+$"
      },
      "description": "Product id from index.json (lowercase name with dashes)"
     }
    ],
    "responses": {
     "200": {
      "description": "Product record",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Product"
        }
       }
      }
     },
     "404": {
      "description": "Unknown product id; check index.json"
     }
    }
   }
  },
  "/categories.json": {
   "get": {
    "operationId": "listCategories",
    "summary": "Categories with their product ids and a 'before you sign' buyer_checklist built from our dossiers (count + evidence)",
    "responses": {
     "200": {
      "description": "Categories"
     }
    }
   }
  },
  "/offers.json": {
   "get": {
    "operationId": "listOffers",
    "summary": "Reader and vendor offers with type, eligibility, benefit structure, evidence, deadline (UTC) and vendor handoff",
    "responses": {
     "200": {
      "description": "Offers"
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Catalog": {
    "type": "object",
    "required": [
     "catalog_version",
     "products"
    ],
    "properties": {
     "catalog_version": {
      "type": "string"
     },
     "updated_at": {
      "type": "string",
      "format": "date"
     },
     "policy": {
      "type": "object"
     },
     "counts": {
      "type": "object"
     },
     "products": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "category": {
         "type": "string"
        },
        "task": {
         "type": [
          "string",
          "null"
         ]
        },
        "entry_price": {
         "type": [
          "string",
          "null"
         ]
        },
        "entry_price_terms": {
         "type": [
          "string",
          "null"
         ]
        },
        "pricing_status": {
         "type": "string"
        },
        "from_price_usd_month": {
         "type": [
          "number",
          "null"
         ]
        },
        "free_plan": {
         "type": "boolean"
        },
        "cost_traps": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "has_plans": {
         "type": "boolean"
        },
        "verified_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "review": {
         "type": [
          "string",
          "null"
         ]
        },
        "record": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "CostTrap": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "quote_only",
       "per_seat",
       "usage_metered",
       "renewal_jump",
       "addons_extra",
       "annual_lock"
      ]
     },
     "label": {
      "type": "string"
     },
     "evidence": {
      "type": "string",
      "description": "Full evidence sentence from the dossier, never truncated"
     },
     "verified_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_url": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "Plan": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "price": {
      "type": "string"
     },
     "includes": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "MeasuredFact": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "value",
     "basis",
     "observed_on",
     "evidence_url"
    ],
    "properties": {
     "value": {
      "enum": [
       true,
       false,
       "not_tested"
      ]
     },
     "basis": {
      "type": "string"
     },
     "observed_on": {
      "type": "string",
      "format": "date"
     },
     "evidence_url": {
      "type": "string",
      "format": "uri"
     }
    }
   },
   "MeasuredClaim": {
    "type": "object",
    "description": "Exactly koopbewijs.api(): vendor claim alongside our observation, not a vendor verification.",
    "required": [
     "claim",
     "claim_source",
     "claim_read_on",
     "observed",
     "observed_on",
     "evidence",
     "status"
    ],
    "properties": {
     "claim": {
      "type": "string"
     },
     "claim_source": {
      "type": "string"
     },
     "claim_read_on": {
      "type": "string",
      "format": "date"
     },
     "observed": {
      "type": "string"
     },
     "observed_on": {
      "type": "string",
      "format": "date"
     },
     "evidence": {
      "type": "object",
      "required": [
       "label",
       "url"
      ],
      "properties": {
       "label": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "format": "uri"
       }
      }
     },
     "status": {
      "enum": [
       "confirmed",
       "contradicted",
       "not_comparable",
       "not_testable",
       "out_of_date"
      ]
     },
     "plan": {
      "type": [
       "string",
       "null"
      ]
     },
     "comparability": {
      "type": [
       "string",
       "null"
      ]
     },
     "buying_consequence": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "MeasuredExitTest": {
    "type": [
     "object",
     "null"
    ],
    "description": "Exactly vertrektest.api() plus a public evidence_url. friction.format describes the route's formats, not a list of formats actually tested. available_fields/not_offered describe the dialog when file_inspected is false; they are never promoted to came_along/lost. Read not_tested and note.",
    "required": [
     "run_date",
     "evidence_url",
     "what",
     "file_inspected",
     "reimport_tested",
     "friction",
     "not_tested",
     "note"
    ],
    "properties": {
     "run_date": {
      "type": "string",
      "format": "date"
     },
     "evidence_url": {
      "type": "string",
      "format": "uri"
     },
     "what": {
      "type": "string"
     },
     "first_import": {
      "type": [
       "string",
       "null"
      ]
     },
     "awkward": {
      "type": [
       "string",
       "null"
      ]
     },
     "file_inspected": {
      "type": "boolean"
     },
     "reimport_tested": {
      "type": "boolean"
     },
     "friction": {
      "type": "object",
      "properties": {
       "export_route": {
        "type": [
         "string",
         "null"
        ]
       },
       "format": {
        "type": [
         "string",
         "null"
        ]
       },
       "reimport": {
        "type": [
         "string",
         "null"
        ]
       },
       "cancellation": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "came_along": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "lost": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "available_fields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "not_offered": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "not_tested": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": "string"
     }
    }
   },
   "Measured": {
    "type": "object",
    "additionalProperties": false,
    "description": "Own hands-on session from handson/<map>/meetlog.json; absent without a matching log. tested_on is the original session date, not the rebuild date; claims and exit tests carry their own observation dates. Unknown facts are not_tested, never inferred from absence. tested_by identifies our team; the actor, account type and blocked/limited attempts are in the review.",
    "required": [
     "tested_on",
     "tested_by",
     "review_url",
     "claims",
     "exit_test",
     "facts"
    ],
    "properties": {
     "tested_on": {
      "type": "string",
      "format": "date"
     },
     "tested_by": {
      "type": "string"
     },
     "review_url": {
      "type": "string",
      "format": "uri"
     },
     "claims": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/MeasuredClaim"
      }
     },
     "exit_test": {
      "$ref": "#/components/schemas/MeasuredExitTest"
     },
     "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "trial_requires_card",
       "trial_duration_confirmed",
       "export_file_inspected",
       "export_reimport_tested",
       "export_direct_download"
      ],
      "properties": {
       "trial_requires_card": {
        "$ref": "#/components/schemas/MeasuredFact"
       },
       "trial_duration_confirmed": {
        "$ref": "#/components/schemas/MeasuredFact"
       },
       "export_file_inspected": {
        "$ref": "#/components/schemas/MeasuredFact"
       },
       "export_reimport_tested": {
        "$ref": "#/components/schemas/MeasuredFact"
       },
       "export_direct_download": {
        "$ref": "#/components/schemas/MeasuredFact"
       }
      }
     }
    }
   },
   "Product": {
    "type": "object",
    "required": [
     "id",
     "name",
     "pricing",
     "purchase",
     "unknowns"
    ],
    "properties": {
     "schema_version": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "vendor_domain": {
      "type": [
       "string",
       "null"
      ]
     },
     "category": {
      "type": "string"
     },
     "task": {
      "type": [
       "string",
       "null"
      ]
     },
     "summary": {
      "type": [
       "string",
       "null"
      ]
     },
     "best_for": {
      "type": [
       "string",
       "null"
      ]
     },
     "skip_if": {
      "type": [
       "string",
       "null"
      ]
     },
     "honest_knock": {
      "type": [
       "string",
       "null"
      ]
     },
     "pricing": {
      "type": "object",
      "properties": {
       "status": {
        "type": "string"
       },
       "entry_price": {
        "type": [
         "string",
         "null"
        ]
       },
       "entry_price_terms": {
        "type": [
         "string",
         "null"
        ]
       },
       "from_price_usd_month": {
        "type": [
         "number",
         "null"
        ],
        "description": "Only when the entry price is US dollars per month. The lowest entry price, often on annual billing: read entry_price_terms"
       },
       "schema_offer": {
        "type": [
         "object",
         "null"
        ],
        "description": "The Offer exactly as it appears in the JSON-LD of the canonical review (what search engines read): one plan's price without commitment where known, with plan and billing basis in description. It can differ from from_price_usd_month, which is the lowest entry price.",
        "properties": {
         "price": {
          "type": "number"
         },
         "currency": {
          "type": [
           "string",
           "null"
          ]
         },
         "description": {
          "type": [
           "string",
           "null"
          ]
         },
         "page": {
          "type": "string"
         }
        }
       },
       "plans": {
        "type": [
         "array",
         "null"
        ],
        "items": {
         "$ref": "#/components/schemas/Plan"
        }
       },
       "plans_source": {
        "type": [
         "string",
         "null"
        ]
       },
       "notes": {
        "type": [
         "string",
         "null"
        ]
       },
       "verified_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "source_url": {
        "type": [
         "string",
         "null"
        ]
       },
       "source_quotes": {
        "type": [
         "array",
         "null"
        ],
        "description": "Verbatim lines from the vendor's own pages (max 200 characters), each matched word for word against the live page on read_on. Only quotes that still agree with pricing.notes.",
        "items": {
         "type": "object",
         "properties": {
          "field": {
           "type": "string",
           "enum": [
            "price",
            "free_trial",
            "refund"
           ]
          },
          "plan": {
           "type": [
            "string",
            "null"
           ]
          },
          "quote": {
           "type": "string"
          },
          "source_url": {
           "type": "string"
          },
          "read_on": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "verification": {
      "type": "object",
      "description": "Per core field: 'quoted' (a verbatim vendor line is in pricing.source_quotes), 'read' (read on the vendor's page on pricing.verified_at, summarised in pricing.notes) or 'being_verified' (not yet matched; not the same as 'does not exist'). 'measured' means a confirmed hands-on trial-duration claim in measured.claims; it does not confirm all trial terms or create a vendor quote.",
      "properties": {
       "price": {
        "type": "string",
        "enum": [
         "quoted",
         "read",
         "being_verified",
         "measured"
        ]
       },
       "free_trial": {
        "type": "string",
        "enum": [
         "quoted",
         "read",
         "being_verified",
         "measured"
        ]
       },
       "refund": {
        "type": "string",
        "enum": [
         "quoted",
         "read",
         "being_verified",
         "measured"
        ]
       }
      }
     },
     "measured": {
      "$ref": "#/components/schemas/Measured"
     },
     "third_party_video": {
      "type": "object",
      "description": "Optional. A YouTube video by another channel that shows the product in use (not ours, not a paid promotion when independent is true). Absent means none was checked or none qualified.",
      "properties": {
       "url": {
        "type": "string"
       },
       "channel": {
        "type": "string"
       },
       "published": {
        "type": [
         "string",
         "null"
        ]
       },
       "shows": {
        "type": [
         "string",
         "null"
        ]
       },
       "independent": {
        "type": "boolean"
       },
       "checked_at": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "free_plan": {
      "type": "boolean"
     },
     "cost_traps": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/CostTrap"
      }
     },
     "compare_with": {
      "type": [
       "object",
       "null"
      ]
     },
     "links": {
      "type": "object"
     },
     "purchase": {
      "type": "object",
      "properties": {
       "seller": {
        "type": "string"
       },
       "how": {
        "type": "string"
       },
       "handoff_url": {
        "type": [
         "string",
         "null"
        ]
       },
       "affiliate": {
        "type": "boolean"
       },
       "disclosure": {
        "type": "string"
       }
      }
     },
     "unknowns": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "provenance": {
      "type": "object"
     }
    }
   }
  }
 }
}
