{
 "openapi": "3.1.0",
 "info": {
  "title": "AIBuilder Marketplace software records",
  "version": "1.0",
  "description": "Read-only records of hand-researched B2B and AI software: prices per plan where structured, cost traps with their full evidence sentence, the date the pricing was read, what is unknown, and the vendor handoff with affiliate disclosure. Static JSON; no authentication.",
  "license": {
   "name": "CC BY 4.0",
   "url": "https://creativecommons.org/licenses/by/4.0/"
  },
  "contact": {
   "url": "https://aibuildermarketplace.com/agents/"
  }
 },
 "servers": [
  {
   "url": "https://aibuildermarketplace.com/api/v1"
  }
 ],
 "paths": {
  "/index.json": {
   "get": {
    "operationId": "listProducts",
    "summary": "Catalog: one compact row per product, plus policy and counts",
    "responses": {
     "200": {
      "description": "Catalog",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Catalog"
        }
       }
      }
     }
    }
   }
  },
  "/products/{id}.json": {
   "get": {
    "operationId": "getProduct",
    "summary": "Full record for one product",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[a-z0-9-]+$"
      },
      "description": "Product id from index.json (lowercase name with dashes)"
     }
    ],
    "responses": {
     "200": {
      "description": "Product record",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Product"
        }
       }
      }
     },
     "404": {
      "description": "Unknown product id; check index.json"
     }
    }
   }
  },
  "/categories.json": {
   "get": {
    "operationId": "listCategories",
    "summary": "Categories with their product ids and a 'before you sign' buyer_checklist built from our dossiers (count + evidence)",
    "responses": {
     "200": {
      "description": "Categories"
     }
    }
   }
  },
  "/offers.json": {
   "get": {
    "operationId": "listOffers",
    "summary": "Reader and vendor offers with type, eligibility, benefit structure, evidence, deadline (UTC) and vendor handoff",
    "responses": {
     "200": {
      "description": "Offers"
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "Catalog": {
    "type": "object",
    "required": [
     "catalog_version",
     "products"
    ],
    "properties": {
     "catalog_version": {
      "type": "string"
     },
     "updated_at": {
      "type": "string",
      "format": "date"
     },
     "policy": {
      "type": "object"
     },
     "counts": {
      "type": "object"
     },
     "products": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "category": {
         "type": "string"
        },
        "task": {
         "type": [
          "string",
          "null"
         ]
        },
        "entry_price": {
         "type": [
          "string",
          "null"
         ]
        },
        "entry_price_terms": {
         "type": [
          "string",
          "null"
         ]
        },
        "pricing_status": {
         "type": "string"
        },
        "from_price_usd_month": {
         "type": [
          "number",
          "null"
         ]
        },
        "free_plan": {
         "type": "boolean"
        },
        "cost_traps": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "has_plans": {
         "type": "boolean"
        },
        "verified_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "review": {
         "type": [
          "string",
          "null"
         ]
        },
        "record": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "CostTrap": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "quote_only",
       "per_seat",
       "usage_metered",
       "renewal_jump",
       "addons_extra",
       "annual_lock"
      ]
     },
     "label": {
      "type": "string"
     },
     "evidence": {
      "type": "string",
      "description": "Full evidence sentence from the dossier, never truncated"
     },
     "verified_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_url": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "Plan": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "price": {
      "type": "string"
     },
     "includes": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "MeasuredFact": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "value",
     "basis",
     "observed_on",
     "evidence_url"
    ],
    "properties": {
     "value": {
      "enum": [
       true,
       false,
       "not_tested"
      ]
     },
     "basis": {
      "type": "string"
     },
     "observed_on": {
      "type": "string",
      "format": "date"
     },
     "evidence_url": {
      "type": "string",
      "format": "uri"
     }
    }
   },
   "MeasuredClaim": {
    "type": "object",
    "description": "Exactly koopbewijs.api(): vendor claim alongside our observation, not a vendor verification.",
    "required": [
     "claim",
     "claim_source",
     "claim_read_on",
     "observed",
     "observed_on",
     "evidence",
     "status"
    ],
    "properties": {
     "claim": {
      "type": "string"
     },
     "claim_source": {
      "type": "string"
     },
     "claim_changed_on": {
      "type": [
       "string",
       "null"
      ],
      "format": "date",
      "description": "First observed absence of the current vendor wording; does not change measurement status."
     },
     "claim_read_on": {
      "type": "string",
      "format": "date"
     },
     "observed": {
      "type": "string"
     },
     "observed_on": {
      "type": "string",
      "format": "date"
     },
     "evidence": {
      "type": "object",
      "required": [
       "label",
       "url"
      ],
      "properties": {
       "label": {
        "type": "string"
       },
       "url": {
        "type": "string",
        "format": "uri"
       }
      }
     },
     "status": {
      "enum": [
       "confirmed",
       "contradicted",
       "not_comparable",
       "not_testable",
       "out_of_date"
      ]
     },
     "plan": {
      "type": [
       "string",
       "null"
      ]
     },
     "comparability": {
      "type": [
       "string",
       "null"
      ]
     },
     "buying_consequence": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "MeasuredExitTest": {
    "type": [
     "object",
     "null"
    ],
    "description": "Exactly vertrektest.api() plus a public evidence_url. friction.format describes the route's formats, not a list of formats actually tested. available_fields/not_offered describe the dialog when file_inspected is false; they are never promoted to came_along/lost. Read not_tested and note.",
    "required": [
     "run_date",
     "evidence_url",
     "what",
     "file_inspected",
     "reimport_tested",
     "friction",
     "not_tested",
     "note"
    ],
    "properties": {
     "run_date": {
      "type": "string",
      "format": "date"
     },
     "evidence_url": {
      "type": "string",
      "format": "uri"
     },
     "what": {
      "type": "string"
     },
     "first_import": {
      "type": [
       "string",
       "null"
      ]
     },
     "awkward": {
      "type": [
       "string",
       "null"
      ]
     },
     "file_inspected": {
      "type": "boolean"
     },
     "reimport_tested": {
      "type": "boolean"
     },
     "friction": {
      "type": "object",
      "properties": {
       "export_route": {
        "type": [
         "string",
         "null"
        ]
       },
       "format": {
        "type": [
         "string",
         "null"
        ]
       },
       "reimport": {
        "type": [
         "string",
         "null"
        ]
       },
       "cancellation": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "came_along": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "lost": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "available_fields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "not_offered": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "not_tested": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": "string"
     }
    }
   },
   "MeasuredCountFact": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "value",
     "basis",
     "observed_on",
     "evidence_url"
    ],
    "properties": {
     "value": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "const": "not_tested"
       }
      ]
     },
     "basis": {
      "type": "string"
     },
     "observed_on": {
      "type": "string",
      "format": "date"
     },
     "evidence_url": {
      "type": "null",
      "description": "Aggregate not rendered in the review in this round."
     }
    }
   },
   "MeasuredInbox": {
    "type": [
     "object",
     "null"
    ],
    "additionalProperties": false,
    "description": "Dated observation of retained INBOX/junk messages, with optional literal timeline. Counts exclude uncertain classifications; time_basis states whether the signup hour is known.",
    "required": [
     "window_start",
     "window_end",
     "window_days",
     "time_basis",
     "status",
     "observed_at",
     "counts",
     "first_sales_email_hours",
     "has_list_unsubscribe",
     "uncertain",
     "after_cancel",
     "after_deletion",
     "after_unsubscribe"
    ],
    "properties": {
     "window_start": {
      "type": "string",
      "format": "date-time"
     },
     "window_end": {
      "type": "string",
      "format": "date-time"
     },
     "window_days": {
      "const": 14,
      "type": "integer"
     },
     "time_basis": {
      "enum": [
       "signup_date_midnight_Europe_Amsterdam",
       "signup_timestamp"
      ],
      "type": "string"
     },
     "status": {
      "enum": [
       "complete",
       "partial"
      ]
     },
     "observed_at": {
      "type": "string",
      "format": "date-time"
     },
     "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "transactional",
       "onboarding_tips",
       "sales_upsell",
       "personal_looking_sales"
      ],
      "properties": {
       "transactional": {
        "type": "integer",
        "minimum": 0
       },
       "onboarding_tips": {
        "type": "integer",
        "minimum": 0
       },
       "sales_upsell": {
        "type": "integer",
        "minimum": 0
       },
       "personal_looking_sales": {
        "type": "integer",
        "minimum": 0
       }
      }
     },
     "first_sales_email_hours": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0
     },
     "has_list_unsubscribe": {
      "type": "boolean"
     },
     "uncertain": {
      "type": "integer",
      "minimum": 0
     },
     "after_cancel": {
      "oneOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "status"
        ],
        "properties": {
         "status": {
          "const": "not_tested"
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "window_start": {
          "type": "string",
          "format": "date-time"
         },
         "window_end": {
          "type": "string",
          "format": "date-time"
         },
         "observed_at": {
          "type": "string",
          "format": "date-time"
         },
         "status": {
          "enum": [
           "complete",
           "partial"
          ]
         },
         "window_days": {
          "const": 30,
          "type": "integer"
         },
         "time_basis": {
          "const": "event_date_midnight_Europe_Amsterdam"
         },
         "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "transactional",
           "marketing",
           "sales"
          ],
          "properties": {
           "transactional": {
            "type": "integer",
            "minimum": 0
           },
           "marketing": {
            "type": "integer",
            "minimum": 0
           },
           "sales": {
            "type": "integer",
            "minimum": 0
           }
          }
         },
         "last_marketing_day": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0,
          "maximum": 29
         },
         "uncertain": {
          "type": "integer",
          "minimum": 0
         },
         "has_list_unsubscribe": {
          "type": "boolean"
         }
        },
        "required": [
         "window_start",
         "window_end",
         "observed_at",
         "status",
         "window_days",
         "time_basis",
         "counts",
         "last_marketing_day",
         "uncertain",
         "has_list_unsubscribe"
        ]
       }
      ]
     },
     "after_deletion": {
      "oneOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "status"
        ],
        "properties": {
         "status": {
          "const": "not_tested"
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "window_start": {
          "type": "string",
          "format": "date-time"
         },
         "window_end": {
          "type": "string",
          "format": "date-time"
         },
         "observed_at": {
          "type": "string",
          "format": "date-time"
         },
         "status": {
          "enum": [
           "complete",
           "partial"
          ]
         },
         "window_days": {
          "const": 30,
          "type": "integer"
         },
         "time_basis": {
          "const": "event_date_midnight_Europe_Amsterdam"
         },
         "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "transactional",
           "marketing",
           "sales"
          ],
          "properties": {
           "transactional": {
            "type": "integer",
            "minimum": 0
           },
           "marketing": {
            "type": "integer",
            "minimum": 0
           },
           "sales": {
            "type": "integer",
            "minimum": 0
           }
          }
         },
         "last_marketing_day": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0,
          "maximum": 29
         },
         "uncertain": {
          "type": "integer",
          "minimum": 0
         },
         "has_list_unsubscribe": {
          "type": "boolean"
         }
        },
        "required": [
         "window_start",
         "window_end",
         "observed_at",
         "status",
         "window_days",
         "time_basis",
         "counts",
         "last_marketing_day",
         "uncertain",
         "has_list_unsubscribe"
        ]
       }
      ]
     },
     "after_unsubscribe": {
      "oneOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "status"
        ],
        "properties": {
         "status": {
          "enum": [
           "not_tested",
           "indeterminate"
          ]
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "status": {
          "enum": [
           "waiting",
           "partial",
           "complete"
          ]
         },
         "submitted_at": {
          "type": "string",
          "format": "date-time"
         },
         "window_start": {
          "type": "string",
          "format": "date-time"
         },
         "window_end": {
          "type": "string",
          "format": "date-time"
         },
         "observed_at": {
          "type": "string",
          "format": "date-time"
         },
         "marketing": {
          "type": "integer",
          "minimum": 0
         },
         "uncertain": {
          "type": "integer",
          "minimum": 0
         }
        },
        "required": [
         "status",
         "submitted_at",
         "window_start",
         "window_end",
         "observed_at",
         "marketing",
         "uncertain"
        ]
       }
      ]
     },
     "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "signup_at",
       "messages"
      ],
      "description": "Literal retained inbox/junk messages. Own correspondence (replies, tickets) excluded; one-time codes, our address and account name replaced in brackets. Missing timeline means not measured, never zero. All display names replaced by vendor team. Exact signup time may be unknown.",
      "properties": {
       "signup_at": {
        "type": [
         "string",
         "null"
        ],
        "format": "date-time"
       },
       "messages": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "received_at": {
           "type": "string",
           "format": "date-time"
          },
          "sender_name": {
           "type": "string",
           "pattern": " team$"
          },
          "sender_domain": {
           "type": "string",
           "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "subject": {
           "type": "string"
          },
          "folder": {
           "enum": [
            "inbox",
            "junk"
           ]
          },
          "offer": {
           "oneOf": [
            {
             "type": "null"
            },
            {
             "type": "object",
             "additionalProperties": false,
             "required": [
              "source",
              "text"
             ],
             "properties": {
              "source": {
               "enum": [
                "subject",
                "body"
               ]
              },
              "text": {
               "type": "string",
               "minLength": 1
              }
             }
            }
           ]
          }
         },
         "required": [
          "received_at",
          "sender_name",
          "sender_domain",
          "subject",
          "folder",
          "offer"
         ]
        }
       }
      }
     }
    }
   },
   "MeasuredInvites": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "default_on",
       "plus_accepted",
       "invitee_can_unsubscribe",
       "address_book_requested",
       "workspace_requested"
      ],
      "properties": {
       "status": {
        "const": "not_tested"
       },
       "default_on": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "plus_accepted": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "invitee_can_unsubscribe": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "address_book_requested": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "workspace_requested": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "window_start": {
        "type": "string",
        "format": "date-time"
       },
       "window_end": {
        "type": "string",
        "format": "date-time"
       },
       "observed_at": {
        "type": "string",
        "format": "date-time"
       },
       "status": {
        "enum": [
         "complete",
         "partial"
        ]
       },
       "default_on": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "plus_accepted": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "invitee_can_unsubscribe": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "address_book_requested": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "workspace_requested": {
        "oneOf": [
         {
          "type": "boolean"
         },
         {
          "const": "not_tested"
         }
        ]
       },
       "window_days": {
        "const": 14,
        "type": "integer"
       },
       "time_basis": {
        "const": "invite_date_midnight_Europe_Amsterdam"
       },
       "counts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "invitations",
         "reminders"
        ],
        "properties": {
         "invitations": {
          "type": "integer",
          "minimum": 0
         },
         "reminders": {
          "type": "integer",
          "minimum": 0
         }
        }
       },
       "uncertain": {
        "type": "integer",
        "minimum": 0
       },
       "has_list_unsubscribe": {
        "type": "boolean"
       },
       "has_one_click_header": {
        "type": "boolean"
       }
      },
      "required": [
       "window_start",
       "window_end",
       "observed_at",
       "status",
       "default_on",
       "plus_accepted",
       "invitee_can_unsubscribe",
       "address_book_requested",
       "workspace_requested",
       "window_days",
       "time_basis",
